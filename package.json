{
  "name": "stretch-timer",
  "version": "1.0.0",
  "description": "Reminds you to stand up and stretch after a set time since unlocking the computer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:fast": "electron . --fast",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "author": "Haakon Skaga",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Stretch Timer",
  "private": true,
  "allowScripts": {
    "electron@44.5.0": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "no.vince.stretch-timer",
    "productName": "Stretch Timer",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "nb"
    ]
  }
}
